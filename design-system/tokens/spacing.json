{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "CreatorOS AI Spacing System",
  "version": "1.0.0",
  "baseUnit": "4px",
  "description": "Strict 4px modular spacing system for layout, margins, padding, and gaps",
  "scale": {
    "0": { "px": "0px", "rem": "0rem" },
    "0.5": { "px": "2px", "rem": "0.125rem", "usage": "Micro padding, hair borders" },
    "1": { "px": "4px", "rem": "0.25rem", "usage": "Tight element spacing, badge padding x" },
    "1.5": { "px": "6px", "rem": "0.375rem", "usage": "Compact button vertical padding" },
    "2": { "px": "8px", "rem": "0.5rem", "usage": "Icon gaps, tag spacing, compact lists" },
    "3": { "px": "12px", "rem": "0.75rem", "usage": "Standard control padding, card compact margins" },
    "4": { "px": "16px", "rem": "1rem", "usage": "Standard component padding, grid gaps" },
    "5": { "px": "20px", "rem": "1.25rem", "usage": "Card internal padding, modal headers" },
    "6": { "px": "24px", "rem": "1.5rem", "usage": "Card padding, section dividers" },
    "8": { "px": "32px", "rem": "2rem", "usage": "Panel gutters, large card padding" },
    "10": { "px": "40px", "rem": "2.5rem", "usage": "Section spacing, dashboard block separation" },
    "12": { "px": "48px", "rem": "3rem", "usage": "Page layout section gutters" },
    "16": { "px": "64px", "rem": "4rem", "usage": "Hero padding, major section gaps" },
    "20": { "px": "80px", "rem": "5rem", "usage": "Landing page rhythm and dividers" },
    "24": { "px": "96px", "rem": "6rem", "usage": "Large section block breaks" },
    "32": { "px": "128px", "rem": "8rem", "usage": "Page hero vertical margins" }
  },
  "containers": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1440px",
    "max": "1600px"
  }
}

